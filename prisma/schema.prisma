generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  prayers  Prayer[]
}

model Prayer {
  id         Int      @id @default(autoincrement())
  thought    String
  prayer     String
  bibleVerse String
  answered   Boolean  @default(false)
  createdAt  DateTime @default(now())
  userId     Int
}
